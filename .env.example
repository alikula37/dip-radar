# Dip Radar environment variables
#
# Copy to .env and adjust as needed; docker compose picks it up automatically.

# SQLite database directory inside the containers (mounted volume).
DB_DIR=/data

# Comma-separated list of browser origins allowed to call the API directly.
# Only needed if you bypass the frontend /api proxy; otherwise leave as-is.
CORS_ORIGINS=http://localhost:3000

# Backend URL used by the frontend server-side proxy (docker compose only).
BACKEND_URL=http://backend:8000

# Optional: route data-provider requests through your own HTTP(S) proxy.
# Leave unset for a direct connection. Example:
# HTTPS_PROXY=http://your-proxy:3128
# HTTP_PROXY=http://your-proxy:3128

# Optional tuning
# SYNC_REQUEST_DELAY=0.15      # seconds between Binance requests
# COINGECKO_BATCH_DELAY=2      # seconds between CoinGecko batches
# LOG_LEVEL=INFO
